# Copy to ".env". All keys are optional — Pathfinder degrades cleanly without them.
# Pathfinder also reuses Station's key loader, so one .env can serve both tools.

# Google Safe Browsing v4 Lookup API (authoritative phishing/malware verdict).
# Free, non-commercial. Google Cloud Console -> enable "Safe Browsing API" -> create an API key.
GSB_API_KEY=

# PhishTank (Cisco Talos) blocklist. OPTIONAL — the check works anonymously but
# rate-limited; a key (if registration is open) raises the limit.
PHISHTANK_API_KEY=

# urlscan.io — only for the optional --render screenshot.
URLSCAN_API_KEY=
